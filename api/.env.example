# Postgres connection (required).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pos_sible

# Browser origins allowed to call this API through the web project's /api rewrite, comma separated, no trailing slash.
# The web app sits on a different host than this API, so its requests carry the web host in Origin.
# Example: https://pos.example.com,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Create the public demo shop (admin / 112233) on an empty database. Off in production unless "true".
POS_SEED_DEMO=true

# Let visitors create their own business at /signup. Off by default so a private install stays private.
POS_ALLOW_SIGNUP=false

# Optional: connection pool size (default 10).
# PG_POOL_MAX=10
