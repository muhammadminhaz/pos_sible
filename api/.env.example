# Used by `docker compose` (read automatically from this folder's .env) and by `npm run dev` (Next.js reads .env too).
# Local setup: cp .env.example .env

# Database password (required by docker compose; Coolify takes it from its UI). Only applies when the volume is first created.
POSTGRES_PASSWORD=postgres

# Host port for Postgres, bound to 127.0.0.1 only. Not 5432, to avoid clashing with other databases on a shared server.
DB_PORT=5435

# Postgres connection for `npm run dev` / `npm run db:*` (docker compose sets its own for the container).
DATABASE_URL=postgres://postgres:postgres@localhost:5435/pos_sible

# Browser origins allowed to call this API through the web project's /api rewrite, comma separated, no trailing slash.
# The web app sits on a different host than this API, so its requests carry the web host in Origin.
# Production default (compose): https://pos-sible.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# Create the public demo shop (admin / 112233) on an empty database. Off in production unless "true".
POS_SEED_DEMO=true

# Let visitors create their own business at /signup. Off by default so a private install stays private.
POS_ALLOW_SIGNUP=false

# Platform owner login for the /admin console on the web app: add business accounts, set their subscription package,
# see how many users and how much storage each uses (never their data). Change the password before going live.
ADMIN_USERNAME=minhaz
ADMIN_PASSWORD=11111111

# Optional: connection pool size (default 10).
# PG_POOL_MAX=10
