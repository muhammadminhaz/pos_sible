# --- Run against Postgres (API mode) -----------------------------------------------------------------------------
# Leave NEXT_PUBLIC_DATA_MODE unset for the original browser-only demo (no database, no server state).
NEXT_PUBLIC_DATA_MODE=api
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pos_sible

# Create the public demo shop (admin / 112233) on first start. In production this is off unless set to "true".
POS_SEED_DEMO=true
# Show the quick-fill demo logins on the sign-in page.
NEXT_PUBLIC_SHOW_DEMO_LOGINS=true

# Let visitors create their own business at /signup. Off by default so a private install stays private.
POS_ALLOW_SIGNUP=false
NEXT_PUBLIC_ALLOW_SIGNUP=false

# Optional: connection pool size (default 10).
# PG_POOL_MAX=10
