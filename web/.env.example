# --- Run against the separately deployed API (API mode) -----------------------------------------------------------
# Leave NEXT_PUBLIC_DATA_MODE unset for the original browser-only demo (no backend, no server state).
NEXT_PUBLIC_DATA_MODE=api

# Where the `api` project runs. /api/* is proxied there (next.config.ts), so the browser only ever talks to this app.
# Both values are read at BUILD time: set them in Vercel's project settings, not just at runtime.
BACKEND_URL=http://localhost:3001


# Offer /signup (the API must also set POS_ALLOW_SIGNUP=true).
NEXT_PUBLIC_ALLOW_SIGNUP=false

# Landing page Contact Us address (mailto in the footer). Optional.
NEXT_PUBLIC_CONTACT_EMAIL=
# Landing page footer: booking link for a discovery call (Cal.com, Calendly...). Optional.
NEXT_PUBLIC_DISCOVERY_CALL_URL=
